#!/bin/bash

#
# 97-noint-worktree
#
# Liferay worktree lifecycle. Two templates (liferay-portal, liferay-ee) stay
# built and are never used for feature work; every feature is a linked
# worktree seeded from its template, with its own bundle, database, and port
# offset: create, configure ports, check alignment, list, status, cleanup.
#

# ==========================================
# Constants — service port defaults
# ==========================================
# Offsets 0 and 1 belong to the templates (liferay-portal, liferay-ee).
# Auto-discovery (_wt_find_offset) starts at _WT_FIRST_FEATURE_OFFSET; pass
# `--offset N` explicitly to configure a template.

_WT_PORT_TOMCAT_HTTP=8080
_WT_PORT_TOMCAT_SHUTDOWN=8005
_WT_PORT_TOMCAT_AJP=8009
_WT_PORT_TOMCAT_HTTPS=8443
_WT_PORT_JDWP=8000
_WT_PORT_OSGI_CONSOLE=11311
_WT_PORT_ES_HTTP=9201
_WT_PORT_ES_TRANSPORT=9301
_WT_PORT_GLOWROOT=4000
_WT_PORT_ARQUILLIAN=32763
_WT_PORT_DATAGUARD=42763
_WT_PORT_JMX_REMOTE=8099

_WT_FIRST_FEATURE_OFFSET=2

# Files that belong to a single worktree and are never seeded from the template.
_WT_LOCAL_FILES=(
    "app.server.$(whoami).properties"
    "init-local.gradle"
    "test.$(whoami).properties"
    "CLAUDE.local.md"
    ".claude/settings.local.json"
)

# ==========================================
# Helpers
# ==========================================
_wt_sed_inplace() {
    if [[ "$(uname)" == "Darwin" ]]; then
        sed -i '' "$@"
    else
        sed -i "$@"
    fi
}

_wt_db_name() {
    # Derive DB name from a worktree dir name.
    # liferay-portal-LPD-12345 -> lportallpd_12345
    # liferay-portal-hotfix    -> lportalhotfix
    # liferay-portal           -> lportal (main)
    # liferay-ee-claude1       -> lportalee_claude1
    local dir_name="$1"
    if [[ "$dir_name" == "liferay-portal" ]]; then
        echo "lportal"
        return
    fi
    local stem="${dir_name#liferay-portal-}"
    [[ "$stem" == "$dir_name" ]] && stem="${dir_name#liferay-}"
    stem=$(echo "$stem" \
        | tr '[:upper:]' '[:lower:]' \
        | sed -E 's/[^a-z0-9]/_/g; s/_+/_/g; s/^_//; s/_$//')
    stem="${stem:0:56}"
    echo "lportal${stem}"
}

_wt_resolve_bundle() {
    # Read app.server.<user>.properties and resolve the bundle parent directory.
    # Falls back to <worktree>/bundle.
    local worktree_root="$1"
    local props="$worktree_root/app.server.$(whoami).properties"
    local parent_dir=""
    if [[ -f "$props" ]]; then
        parent_dir=$(grep -E '^app\.server\.parent\.dir=' "$props" \
            | tail -n 1 \
            | cut -d= -f2-)
        parent_dir="${parent_dir//\$\{project.dir\}/$worktree_root}"
    fi
    [[ -z "$parent_dir" ]] && parent_dir="$worktree_root/bundle"
    echo "${parent_dir%/}"
}

_wt_tomcat_version() {
    # The Tomcat version the checkout builds into: app.server.tomcat.version,
    # per-user properties first.
    local worktree_dir="$1"
    local file version
    for file in "$worktree_dir/app.server.$(whoami).properties" "$worktree_dir/app.server.properties"; do
        [[ -f "$file" ]] || continue
        version=$(grep -E '^[[:space:]]*app\.server\.tomcat\.version=' "$file" | tail -n 1 | cut -d= -f2- | tr -d '[:space:]')
        if [[ -n "$version" ]]; then
            echo "$version"
            return 0
        fi
    done
}

_wt_find_tomcat() {
    # With a worktree, the tomcat-<app.server.tomcat.version> its build
    # unpacks: `ant all` leaves older tomcat-* dirs and the `tomcat` symlink
    # behind, and a release branch can need an older version than the newest
    # dir. Otherwise the `tomcat` symlink, else the highest version.
    local bundle_dir="$1"
    local worktree_dir="$2"
    [[ -d "$bundle_dir" ]] || return 0
    if [[ -n "$worktree_dir" ]]; then
        local version
        version=$(_wt_tomcat_version "$worktree_dir")
        if [[ -n "$version" && -d "$bundle_dir/tomcat-$version" ]]; then
            readlink -f "$bundle_dir/tomcat-$version"
            return 0
        fi
    fi
    if [[ -L "$bundle_dir/tomcat" && -d "$bundle_dir/tomcat" ]]; then
        readlink -f "$bundle_dir/tomcat"
        return 0
    fi
    local tomcat_dir
    tomcat_dir=$(find "$bundle_dir" -maxdepth 1 -type d -name 'tomcat-*' 2>/dev/null | sort -V | tail -n 1)
    [[ -n "$tomcat_dir" ]] && readlink -f "$tomcat_dir"
}

_wt_running_tomcats() {
    # Canonical catalina.base of every running Tomcat, one per line.
    local base
    ps -eo args 2>/dev/null \
        | grep --only-matching '\-Dcatalina\.base=[^ ]*' \
        | sed 's/-Dcatalina.base=//' \
        | while IFS= read -r base; do
            readlink -f "$base"
        done
}

_wt_is_main_worktree() {
    # The main worktree owns the repository; linked worktrees point into it.
    local worktree_dir="$1"
    local git_dir common_dir
    git_dir=$(cd "$worktree_dir" 2>/dev/null && git rev-parse --absolute-git-dir 2>/dev/null)
    common_dir=$(cd "$worktree_dir" 2>/dev/null && cd "$(git rev-parse --git-common-dir 2>/dev/null)" && pwd -P)
    [[ -n "$git_dir" && "$git_dir" == "$common_dir" ]]
}

_wt_main_worktree() {
    # Print the main worktree of the repository that contains $1.
    local common_dir
    common_dir=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
    dirname "$common_dir"
}

_wt_offset_ports_free() {
    local offset="$1"
    local p
    for p in \
        $((_WT_PORT_TOMCAT_HTTP + offset)) \
        $((_WT_PORT_TOMCAT_SHUTDOWN + offset)) \
        $((_WT_PORT_JDWP + offset)) \
        $((_WT_PORT_OSGI_CONSOLE + offset)) \
        $((_WT_PORT_ES_HTTP + offset)) \
        $((_WT_PORT_ES_TRANSPORT + offset)) \
        $((_WT_PORT_GLOWROOT + offset)); do
        if nc -z localhost "$p" 2>/dev/null; then
            return 1
        fi
    done
    return 0
}

_wt_find_offset() {
    # Skip offsets claimed by any bundle, running or not, so a stopped
    # worktree keeps its ports.
    local claimed
    claimed=$(cat "${LIFERAY_BASE:-$HOME/repositories}"/bundles/*/.worktree-port-offset 2>/dev/null)
    local offset=$_WT_FIRST_FEATURE_OFFSET
    while (( offset < 100 )); do
        if ! grep -qx "$offset" <<< "$claimed" && _wt_offset_ports_free "$offset"; then
            echo "$offset"
            return 0
        fi
        offset=$((offset + 1))
    done
    return 1
}

_wt_current_http_port() {
    # Extract the HTTP/1.1 connector port from server.xml.
    local server_xml="$1"
    grep -oE 'port="[0-9]+"[^>]*protocol="HTTP/1\.1"|protocol="HTTP/1\.1"[^>]*port="[0-9]+"' "$server_xml" 2>/dev/null \
        | grep -oE 'port="[0-9]+"' \
        | head -n 1 \
        | grep -oE '[0-9]+'
}

_wt_remove_property() {
    local file="$1"
    local key="$2"
    [[ -f "$file" ]] || return 0
    local escaped
    escaped=$(printf '%s' "$key" | sed -e 's/[]\/$*.^[]/\\&/g')
    _wt_sed_inplace -E "/^${escaped}=/d" "$file"
}

_wt_worktree_branch() {
    # Find the branch name for an absolute worktree path via porcelain output.
    local target="$1"
    git -C "$target" worktree list --porcelain 2>/dev/null | awk \
        -v target="$target" '
        $1 == "worktree" { current = $2 }
        $1 == "branch" && current == target {
            sub("refs/heads/", "", $2)
            print $2
            exit
        }
    '
}

_wt_branch_checkout() {
    # Print the worktree where a local branch is checked out, if any.
    local repo_dir="$1"
    local branch="$2"
    git -C "$repo_dir" worktree list --porcelain 2>/dev/null | awk \
        -v ref="refs/heads/$branch" '
        $1 == "worktree" { current = $2 }
        $1 == "branch" && $2 == ref {
            print current
            exit
        }
    '
}

_wt_psql() {
    # Peer-authenticated psql as the current user when that role exists
    # (create role <user> login createdb; grant sa to <user>), else via sudo.
    if psql -d postgres -Atqc 'select 1' >/dev/null 2>&1; then
        psql -d postgres "$@"
    else
        sudo -u postgres psql "$@"
    fi
}

# ==========================================
# Families — one template per repository
# ==========================================
# Every default can be overridden from the environment (01-environment).

_wt_template_dir() {
    case "$1" in
        portal) echo "${LIFERAY_PRJ:-${LIFERAY_BASE:-$HOME/repositories}/liferay-portal}" ;;
        ee) echo "${LIFERAY_PRJ_EE:-${LIFERAY_BASE:-$HOME/repositories}/liferay-ee}" ;;
    esac
}

_wt_family_local() {
    # Local branch the template is kept on.
    case "$1" in
        portal) echo "${WTCLI_PORTAL_LOCAL:-master}" ;;
        ee) echo "${WTCLI_EE_LOCAL:-release-2026.q1}" ;;
    esac
}

_wt_family_base() {
    # Ref that new feature branches start from.
    case "$1" in
        portal) echo "${WTCLI_PORTAL_BASE:-origin/master}" ;;
        ee) echo "${WTCLI_EE_BASE:-liferay-ee/release-2026.q1}" ;;
    esac
}

_wt_family_upstream() {
    # Reference the local branch and the base are checked against. For the
    # portal it defaults to what the local branch tracks (the repository that
    # origin is forked from); for EE it is the base itself.
    local family="$1"
    case "$family" in
        portal)
            if [[ -n "$WTCLI_PORTAL_UPSTREAM" ]]; then
                echo "$WTCLI_PORTAL_UPSTREAM"
            else
                git -C "$(_wt_template_dir portal)" rev-parse --abbrev-ref "$(_wt_family_local portal)@{upstream}" 2>/dev/null
            fi
            ;;
        ee) echo "${WTCLI_EE_UPSTREAM:-$(_wt_family_base ee)}" ;;
    esac
}

_wt_family_of() {
    # Print the family whose template shares the git repository of $1.
    local common_dir
    common_dir=$(git -C "${1:-$PWD}" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
    local family template
    for family in portal ee; do
        template=$(_wt_template_dir "$family")
        [[ -d "$template" ]] || continue
        if [[ "$(git -C "$template" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" == "$common_dir" ]]; then
            echo "$family"
            return 0
        fi
    done
    return 1
}

_wt_resolve_family() {
    # An explicit family wins; otherwise the one of the cwd, else portal.
    if [[ -n "$1" ]]; then
        echo "$1"
    else
        _wt_family_of "$PWD" || echo "portal"
    fi
}

# ==========================================
# Alignment
# ==========================================
_wt_fetch_refs() {
    # Fetch each "<remote>/<branch>" ref so comparisons reflect the remotes.
    # Refs that are not remote-tracking (local branches, SHAs) are skipped.
    local repo_dir="$1"
    shift
    local ref remote
    for ref in "$@"; do
        remote="${ref%%/*}"
        [[ "$remote" == "$ref" ]] && continue
        git -C "$repo_dir" remote get-url "$remote" >/dev/null 2>&1 || continue
        git -C "$repo_dir" fetch --quiet "$remote" "${ref#*/}" \
            || echo "Warning: could not fetch $ref."
    done
}

_wt_compare() {
    # Print how $2 relates to $3: aligned, behind N, ahead N, diverged A/B,
    # or missing <ref>.
    local repo_dir="$1"
    local left="$2"
    local right="$3"
    local ref
    for ref in "$left" "$right"; do
        if ! git -C "$repo_dir" rev-parse -q --verify "${ref}^{commit}" >/dev/null; then
            echo "missing $ref"
            return 0
        fi
    done
    local ahead behind
    read -r ahead behind < <(git -C "$repo_dir" rev-list --left-right --count "${left}...${right}")
    if (( ahead == 0 && behind == 0 )); then
        echo "aligned"
    elif (( ahead == 0 )); then
        echo "behind $behind"
    elif (( behind == 0 )); then
        echo "ahead $ahead"
    else
        echo "diverged $ahead/$behind"
    fi
}

_wt_check() {
    # Report how the family's local branch and base line up with the
    # upstream. Only remote-tracking refs change (fetch); never blocks.
    local family="$1"
    local fetch="${2:-1}"
    local template
    template=$(_wt_template_dir "$family")
    if [[ ! -d "$template" ]]; then
        echo "Template not found: $template"
        return 1
    fi
    local local_branch base upstream
    local_branch=$(_wt_family_local "$family")
    base=$(_wt_family_base "$family")
    upstream=$(_wt_family_upstream "$family")
    if [[ -z "$upstream" ]]; then
        echo "No upstream for $local_branch; set WTCLI_PORTAL_UPSTREAM or run 'git branch -u <remote>/<branch> $local_branch'. Using $base."
        upstream="$base"
    fi

    (( fetch )) && _wt_fetch_refs "$template" $(printf '%s\n' "$base" "$upstream" | sort -u)

    local rows=("$local_branch $upstream")
    [[ "$base" != "$upstream" ]] && rows+=("$base $upstream" "$local_branch $base")

    printf '\n=== Alignment: %s (upstream %s) ===\n' "$family" "$upstream"
    local row state misaligned=0
    for row in "${rows[@]}"; do
        state=$(_wt_compare "$template" ${row})
        [[ "$state" != "aligned" ]] && misaligned=1
        printf '  %-30s vs %-30s %s\n' ${row} "$state"
    done

    local template_behind
    template_behind=$(git -C "$template" rev-list --count "HEAD..${base}" 2>/dev/null)
    if [[ -n "$template_behind" && "$template_behind" != "0" ]]; then
        printf '  Template %s is %s commits behind %s: refresh it with "git pull" + "lifcli rebuild".\n' \
            "$(basename "$template")" "$template_behind" "$base"
    fi
    (( misaligned )) && echo "  Run 'wtcli sync$([[ "$family" == ee ]] && echo ' --ee')' to align (it never pushes)."
    return 0
}

_wt_sync() {
    # Fast-forward the local branch to the upstream when strictly behind.
    # Anything else (ahead, diverged, the base on origin) is only reported,
    # with the command to run: wtcli never pushes.
    local family="$1"
    _wt_check "$family" || return 1
    local template local_branch base upstream
    template=$(_wt_template_dir "$family")
    local_branch=$(_wt_family_local "$family")
    base=$(_wt_family_base "$family")
    upstream=$(_wt_family_upstream "$family")
    [[ -z "$upstream" ]] && upstream="$base"

    echo
    local state checkout
    state=$(_wt_compare "$template" "$local_branch" "$upstream")
    case "$state" in
        aligned)
            echo "$local_branch is aligned with $upstream."
            ;;
        behind*)
            checkout=$(_wt_branch_checkout "$template" "$local_branch")
            if [[ -z "$checkout" ]]; then
                git -C "$template" update-ref "refs/heads/$local_branch" \
                    "$(git -C "$template" rev-parse "$upstream")" \
                    "$(git -C "$template" rev-parse "$local_branch")" \
                    && echo "Fast-forwarded $local_branch to $upstream."
            elif [[ -n "$(git -C "$checkout" status --porcelain --untracked-files=no)" ]]; then
                echo "$local_branch is checked out with local changes in $checkout; fast-forward it there yourself."
            else
                git -C "$checkout" merge --ff-only --quiet "$upstream" \
                    && echo "Fast-forwarded $local_branch in $checkout to $upstream."
            fi
            ;;
        missing*)
            echo "Cannot sync $local_branch: $state."
            ;;
        *)
            echo "$local_branch is $state relative to $upstream; leaving it alone. To reset it:"
            echo "  git -C $template branch -f $local_branch $upstream   (fails while it is checked out)"
            ;;
    esac

    if [[ "$base" != "$upstream" ]]; then
        state=$(_wt_compare "$template" "$base" "$upstream")
        if [[ "$state" != "aligned" ]]; then
            echo "$base is $state relative to $upstream. wtcli never pushes; to update it, run:"
            echo "  git -C $template push ${base%%/*} $upstream:refs/heads/${base#*/}"
        fi
    fi
}

# ==========================================
# Port configuration steps
# ==========================================
_wt_patch_server_xml() {
    local tomcat_dir="$1"
    local offset="$2"
    local server_xml="$tomcat_dir/conf/server.xml"
    [[ -f "$server_xml" ]] || { echo "server.xml not found: $server_xml"; return 1; }

    local target_http=$((_WT_PORT_TOMCAT_HTTP + offset))
    if grep -q "port=\"${target_http}\"" "$server_xml"; then
        echo "server.xml already at offset ${offset}, skipping."
        return 0
    fi

    local current_http
    current_http=$(_wt_current_http_port "$server_xml")
    if [[ -z "$current_http" ]]; then
        echo "Could not detect current HTTP port in $server_xml"
        return 1
    fi
    local current_offset=$((current_http - _WT_PORT_TOMCAT_HTTP))

    local current_shutdown=$((_WT_PORT_TOMCAT_SHUTDOWN + current_offset))
    local current_ajp=$((_WT_PORT_TOMCAT_AJP + current_offset))
    local current_https=$((_WT_PORT_TOMCAT_HTTPS + current_offset))
    local target_shutdown=$((_WT_PORT_TOMCAT_SHUTDOWN + offset))
    local target_ajp=$((_WT_PORT_TOMCAT_AJP + offset))
    local target_https=$((_WT_PORT_TOMCAT_HTTPS + offset))

    _wt_sed_inplace \
        -e "s/port=\"${current_shutdown}\"/port=\"${target_shutdown}\"/g" \
        -e "s/port=\"${current_http}\"/port=\"${target_http}\"/g" \
        -e "s/port=\"${current_ajp}\"/port=\"${target_ajp}\"/g" \
        -e "s/port=\"${current_https}\"/port=\"${target_https}\"/g" \
        -e "s/redirectPort=\"${current_https}\"/redirectPort=\"${target_https}\"/g" \
        "$server_xml"
}

_wt_patch_setenv() {
    # JDWP debug port for `catalina.sh jpda start`. setenv.sh survives rebuild.
    local tomcat_dir="$1"
    local offset="$2"
    local file="$tomcat_dir/bin/setenv.sh"
    local target=$((_WT_PORT_JDWP + offset))
    local target_value="localhost:${target}"
    local target_line="export JPDA_ADDRESS=\"${target_value}\""

    touch "$file"
    if grep -qE "JPDA_ADDRESS=\"?${target_value}\"?(\$|[^0-9])" "$file"; then
        echo "setenv.sh JPDA_ADDRESS already at ${target_value}, skipping."
        return 0
    fi
    if grep -qE '^[[:space:]]*(export[[:space:]]+)?JPDA_ADDRESS=' "$file"; then
        _wt_sed_inplace -E "s|^[[:space:]]*(export[[:space:]]+)?JPDA_ADDRESS=.*|${target_line}|" "$file"
    else
        echo "${target_line}" >> "$file"
    fi
}

_wt_patch_developer_properties() {
    # Wiped on rebuild — always reapply.
    local tomcat_dir="$1"
    local offset="$2"
    local props="$tomcat_dir/webapps/ROOT/WEB-INF/classes/portal-developer.properties"
    local target=$((_WT_PORT_OSGI_CONSOLE + offset))
    if [[ ! -f "$props" ]]; then
        echo "portal-developer.properties not found, skipping."
        return 0
    fi
    if grep -qE 'osgi\.console=' "$props"; then
        _wt_sed_inplace -E "s|osgi\.console=.*|osgi.console=localhost:${target}|" "$props"
    else
        echo "module.framework.properties.osgi.console=localhost:${target}" >> "$props"
    fi
}

_wt_write_es_config() {
    # Wiped on rebuild — always overwrite.
    # Write both ES7 and ES8 configs; only the active module reads its own file.
    local bundle_dir="$1"
    local offset="$2"
    local http=$((_WT_PORT_ES_HTTP + offset))
    local transport=$((_WT_PORT_ES_TRANSPORT + offset))
    mkdir -p "$bundle_dir/osgi/configs"
    local version
    for version in 7 8; do
        cat > "$bundle_dir/osgi/configs/com.liferay.portal.search.elasticsearch${version}.configuration.ElasticsearchConfiguration.config" <<EOF
sidecarHttpPort="${http}"
transportTcpPort="${transport}"
networkBindHost="127.0.0.1"
networkPublishHost="127.0.0.1"
EOF
    done
}

_wt_write_arquillian_config() {
    local bundle_dir="$1"
    local offset="$2"
    local file="$bundle_dir/osgi/configs/com.liferay.arquillian.extension.junit.bridge.connector.ArquillianConnector.config"
    local port=$((_WT_PORT_ARQUILLIAN + offset))
    mkdir -p "$bundle_dir/osgi/configs"
    cat > "$file" <<EOF
port="${port}"
EOF
}

_wt_write_dataguard_config() {
    local bundle_dir="$1"
    local offset="$2"
    local file="$bundle_dir/osgi/configs/com.liferay.data.guard.connector.DataGuardConnector.config"
    local port=$((_WT_PORT_DATAGUARD + offset))
    mkdir -p "$bundle_dir/osgi/configs"
    cat > "$file" <<EOF
port="${port}"
EOF
}

_wt_patch_glowroot() {
    # Survives rebuild — skip if already correct.
    local bundle_dir="$1"
    local offset="$2"
    local file="$bundle_dir/glowroot/admin.json"
    local target=$((_WT_PORT_GLOWROOT + offset))
    [[ -f "$file" ]] || { echo "glowroot/admin.json not found, skipping."; return 0; }

    if ! command -v jq >/dev/null 2>&1; then
        echo "jq not installed; set glowroot/admin.json .web.port=${target} manually."
        return 0
    fi

    local current
    current=$(jq -r '.web.port // empty' "$file")
    if [[ "$current" == "$target" ]]; then
        echo "glowroot/admin.json already at port ${target}, skipping."
        return 0
    fi
    local tmp="${file}.tmp"
    jq ".web.port = ${target}" "$file" > "$tmp" && mv "$tmp" "$file"
}

_wt_patch_test_user_properties() {
    # Sets jmx.remote.port in <worktree>/test.${user}.properties so that
    # SetUpArquillianTask substitutes the per-offset port into arquillian.xml.
    # The file is gitignored (.gitignore: /test.*.properties), safe to overwrite.
    local worktree_dir="$1"
    local offset="$2"
    local file="$worktree_dir/test.$(whoami).properties"
    local target=$((_WT_PORT_JMX_REMOTE + offset))

    touch "$file"
    _wt_remove_property "$file" "jmx.remote.port"
    echo "jmx.remote.port=${target}" >> "$file"
}

_wt_write_init_local_gradle() {
    # Writes <worktree>/init-local.gradle so `gradle -I init-local.gradle ...`
    # points testIntegration at this worktree's offset-shifted ports.
    # - testIntegrationTomcat.portNumber  -> HTTP (BaseAppServerTask.isReachable)
    # - liferay.arquillian.port sysprop   -> forwarded to test JVM by
    #   TestIntegrationPlugin so the JUnit bridge socket connects correctly.
    # Regenerated on every configure; not committed (see _wt_exclude_local_files).
    local worktree_dir="$1"
    local offset="$2"
    local file="$worktree_dir/init-local.gradle"
    local http=$((_WT_PORT_TOMCAT_HTTP + offset))
    local arq=$((_WT_PORT_ARQUILLIAN + offset))

    cat > "$file" <<EOF
// Generated by wtcli configure. Do not commit; regenerated on each run.
//
// Aligns the testIntegration Gradle plugin with this worktree's port offset
// so it discovers the running Liferay instead of starting a managed Tomcat.
//
// Usage:
//   gradle -I init-local.gradle <task>

System.setProperty('liferay.arquillian.port', '${arq}')

allprojects {
	afterEvaluate { project ->
		def ext = project.extensions.findByName('testIntegrationTomcat')
		if (ext != null) {
			ext.portNumber = ${http}
		}
	}
}
EOF
}

_wt_exclude_local_files() {
    # Idempotently adds every per-worktree file (_WT_LOCAL_FILES) to the
    # worktree's effective info/exclude (which is the common gitdir's
    # info/exclude when this is a linked worktree, so `git status` stays clean
    # across all worktrees). Not every branch's .gitignore covers them all,
    # e.g. CLAUDE.local.md on older release branches.
    local worktree_dir="$1"
    local common_dir
    common_dir=$(git -C "$worktree_dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
    [[ -z "$common_dir" ]] && return 0
    local exclude_file="$common_dir/info/exclude"
    mkdir -p "$common_dir/info"
    touch "$exclude_file"
    local file
    for file in "${_WT_LOCAL_FILES[@]}"; do
        if ! grep -qFx "/${file}" "$exclude_file" && ! grep -qFx "${file}" "$exclude_file"; then
            printf '\n# Added by wtcli — per-worktree file\n/%s\n' "$file" >> "$exclude_file"
        fi
    done
}

_wt_patch_portal_ext() {
    # Survives rebuild. Preserve existing JDBC user/pass when present.
    local bundle_dir="$1"
    local offset="$2"
    local db_name="$3"
    local file="$bundle_dir/portal-ext.properties"
    local http=$((_WT_PORT_TOMCAT_HTTP + offset))

    touch "$file"

    local jdbc_user jdbc_pass
    jdbc_user=$(grep -E '^jdbc\.default\.username=' "$file" | tail -n 1 | cut -d= -f2-)
    jdbc_pass=$(grep -E '^jdbc\.default\.password=' "$file" | tail -n 1 | cut -d= -f2-)
    [[ -z "$jdbc_user" ]] && jdbc_user="sa"
    [[ -z "$jdbc_pass" ]] && jdbc_pass="sa"

    local key
    for key in \
        include-and-override \
        portal.instance.inet.socket.address \
        portal.instance.http.socket.address \
        browser.launcher.url \
        setup.wizard.enabled \
        terms.of.use.required \
        passwords.default.policy.change.required \
        users.reminder.queries.enabled \
        jdbc.default.driverClassName \
        jdbc.default.url \
        jdbc.default.username \
        jdbc.default.password; do
        _wt_remove_property "$file" "$key"
    done

    {
        echo "include-and-override=portal-developer.properties"
        echo "portal.instance.inet.socket.address=localhost:${http}"
        echo "browser.launcher.url="
        echo "setup.wizard.enabled=false"
        echo "terms.of.use.required=false"
        echo "passwords.default.policy.change.required=false"
        echo "users.reminder.queries.enabled=false"
        echo "jdbc.default.driverClassName=org.postgresql.Driver"
        echo "jdbc.default.url=jdbc:postgresql://localhost:5432/${db_name}"
        echo "jdbc.default.username=${jdbc_user}"
        echo "jdbc.default.password=${jdbc_pass}"
    } >> "$file"
}

_wt_create_database() {
    local db_name="$1"
    if ! command -v psql >/dev/null 2>&1; then
        echo "psql CLI not available. Run manually:"
        echo "  sudo -u postgres psql -c 'create database ${db_name} owner sa;'"
        return 0
    fi

    if [[ -n "$(_wt_psql -Atc "select 1 from pg_database where datname = '${db_name}'")" ]]; then
        echo "Database ${db_name} already exists, skipping."
        return 0
    fi
    _wt_psql -c "create database ${db_name} owner sa;"
}

_wt_drop_database() {
    local db_name="$1"
    if ! command -v psql >/dev/null 2>&1; then
        echo "psql CLI not available. Run manually:"
        echo "  sudo -u postgres psql -c 'drop database ${db_name} with (force);'"
        return 0
    fi

    _wt_psql -c "drop database if exists ${db_name} with (force);"
}

_wt_clear_osgi_state() {
    local bundle_dir="$1"
    rm -rf "$bundle_dir/osgi/state"
}

_wt_print_summary() {
    local worktree_dir="$1"
    local bundle_dir="$2"
    local offset="$3"
    local db_name="$4"

    local http=$((_WT_PORT_TOMCAT_HTTP + offset))
    local shutdown=$((_WT_PORT_TOMCAT_SHUTDOWN + offset))
    local ajp=$((_WT_PORT_TOMCAT_AJP + offset))
    local https=$((_WT_PORT_TOMCAT_HTTPS + offset))
    local jdwp=$((_WT_PORT_JDWP + offset))
    local osgi=$((_WT_PORT_OSGI_CONSOLE + offset))
    local es_http=$((_WT_PORT_ES_HTTP + offset))
    local es_tx=$((_WT_PORT_ES_TRANSPORT + offset))
    local glow=$((_WT_PORT_GLOWROOT + offset))
    local arq=$((_WT_PORT_ARQUILLIAN + offset))
    local dg=$((_WT_PORT_DATAGUARD + offset))
    local jmx=$((_WT_PORT_JMX_REMOTE + offset))

    printf '\n=== Worktree Configuration ===\n'
    printf 'Worktree:       %s\n' "$worktree_dir"
    printf 'Bundle:         %s\n' "$bundle_dir"
    printf 'Offset:         %s\n' "$offset"
    printf 'Database:       %s\n\n' "$db_name"
    printf 'Ports:\n'
    printf '  Tomcat HTTP      %s\n' "$http"
    printf '  Tomcat Shutdown  %s\n' "$shutdown"
    printf '  Tomcat AJP       %s\n' "$ajp"
    printf '  HTTPS Redirect   %s\n' "$https"
    printf '  JDWP             %s\n' "$jdwp"
    printf '  OSGi Console     %s\n' "$osgi"
    printf '  ES HTTP          %s\n' "$es_http"
    printf '  ES Transport     %s\n' "$es_tx"
    printf '  Glowroot         %s\n' "$glow"
    printf '  Arquillian       %s\n' "$arq"
    printf '  DataGuard        %s\n' "$dg"
    printf '  JMX Remote       %s\n\n' "$jmx"
    printf 'Liferay:    http://localhost:%s\n' "$http"
    printf 'Glowroot:   http://localhost:%s\n' "$glow"
}

# ==========================================
# Action: Configure ports for a single worktree
# ==========================================
_wt_configure_ports() {
    local worktree_dir="$1"
    local desired_offset="$2"
    local skip_db="${3:-0}"

    local bundle_dir
    bundle_dir=$(_wt_resolve_bundle "$worktree_dir")
    local tomcat_dir
    tomcat_dir=$(_wt_find_tomcat "$bundle_dir" "$worktree_dir")
    if [[ -z "$tomcat_dir" ]]; then
        echo "No tomcat-* directory under $bundle_dir. Run 'ant all' first."
        return 1
    fi
    # lifcli starts <bundle>/tomcat: keep that symlink on the built Tomcat.
    if [[ -L "$bundle_dir/tomcat" || ! -e "$bundle_dir/tomcat" ]]; then
        ln -sfn "$(basename "$tomcat_dir")" "$bundle_dir/tomcat"
    fi

    local offset_file="$bundle_dir/.worktree-port-offset"
    local offset=""
    if [[ -n "$desired_offset" ]]; then
        offset="$desired_offset"
    elif [[ -f "$offset_file" ]]; then
        offset=$(cat "$offset_file")
    else
        offset=$(_wt_find_offset)
        if [[ -z "$offset" ]]; then
            echo "Could not find a free port offset (${_WT_FIRST_FEATURE_OFFSET}..99)."
            return 1
        fi
    fi
    echo "$offset" > "$offset_file"

    local dir_name
    dir_name=$(basename "$worktree_dir")
    local db_name
    db_name=$(_wt_db_name "$dir_name")

    _wt_patch_server_xml "$tomcat_dir" "$offset" || return 1
    _wt_patch_setenv "$tomcat_dir" "$offset"
    _wt_patch_developer_properties "$tomcat_dir" "$offset"
    _wt_write_es_config "$bundle_dir" "$offset"
    _wt_write_arquillian_config "$bundle_dir" "$offset"
    _wt_write_dataguard_config "$bundle_dir" "$offset"
    _wt_patch_glowroot "$bundle_dir" "$offset"
    _wt_patch_portal_ext "$bundle_dir" "$offset" "$db_name"
    _wt_patch_test_user_properties "$worktree_dir" "$offset"
    _wt_write_init_local_gradle "$worktree_dir" "$offset"
    _wt_exclude_local_files "$worktree_dir"
    (( skip_db )) || _wt_create_database "$db_name"
    _wt_clear_osgi_state "$bundle_dir"

    _wt_print_summary "$worktree_dir" "$bundle_dir" "$offset" "$db_name"
}

# ==========================================
# Action: New
# ==========================================
_wt_seed_build_output() {
    # Reflink-copy the template's ignored files (build output, node_modules,
    # .gradle, IDE files) so the worktree starts built. Tracked files come
    # from the checkout and are never overwritten; per-worktree files and
    # nested worktrees are skipped. Only paths the worktree's own .gitignore
    # also ignores are copied, so a template on another branch cannot leave
    # untracked files behind.
    local template="$1"
    local worktree_dir="$2"
    local skip_regex
    skip_regex="^($(printf '%s|' "${_WT_LOCAL_FILES[@]}" | sed 's/\./\\./g')\.claude/worktrees/|\.gradle/(daemon|\.tmp|workers)/|bundle/)"
    (
        cd "$template" &&
        git ls-files -z --others --ignored --exclude-standard --directory \
            | grep -zEv "$skip_regex" \
            | git -C "$worktree_dir" check-ignore -z --stdin \
            | xargs -0 -r cp -a --reflink=auto --no-clobber --parents -t "$worktree_dir"
    )
}

_wt_copy_bundle() {
    # Reflink-copy the template bundle without the state tied to the
    # template's database (data/, osgi/state) or process (logs, work), then
    # repoint the absolute paths it carries (tomcat symlink, liferay.home,
    # setenv.sh agents) at this worktree.
    local src="$1"
    local dst="$2"
    local src_prj="$3"
    local dst_prj="$4"

    mkdir -p "$dst" || return 1
    local entry name
    for entry in "$src"/* "$src"/.[!.]*; do
        [[ -e "$entry" || -L "$entry" ]] || continue
        name=$(basename "$entry")
        case "$name" in
            data|logs|reports|work|.worktree-port-offset) continue ;;
        esac
        cp -a --reflink=auto "$entry" "$dst/" || return 1
    done
    rm -rf "$dst/osgi/state" "$dst"/tomcat-*/{logs,temp,work}/*

    if [[ -L "$dst/tomcat" ]]; then
        ln -sfn "$(basename "$(readlink "$dst/tomcat")")" "$dst/tomcat"
    fi

    local file
    for file in "$dst"/*.properties "$dst"/tomcat-*/bin/setenv.sh; do
        [[ -f "$file" ]] || continue
        _wt_sed_inplace \
            -e "s#${src}#${dst}#g" \
            -e "s#${src_prj}/#${dst_prj}/#g" \
            -e "s#${src_prj}\$#${dst_prj}#g" \
            "$file"
    done
}

_wt_write_claude_local() {
    # Instructions for Claude sessions opened in this worktree. Gitignored,
    # so it survives branch switches and stays out of commits.
    local worktree_dir="$1"
    local env_name="$2"
    local file="$worktree_dir/CLAUDE.local.md"
    [[ -f "$file" ]] && return 0
    cat > "$file" <<EOF
# Local Worktree

This checkout is a wtcli-managed worktree with its own bundle, database, and port offset (\`wtcli status\` prints them).

- Work only in this worktree. Do not edit other checkouts under \`~/repositories\`.
- Create another worktree only with \`wtcli new <name> [--ee] [--base <ref>] [--reuse|--detach]\`. Never use \`EnterWorktree\`, \`git worktree add\`, or agent worktree isolation: they skip the bundle, database, and port setup.
- Before starting another Tomcat, run \`wtcli list\`: this machine fits about four running portals.
- Remove a worktree (\`wtcli cleanup\`) only after the user agrees.
- Use \`lifcli -e ${env_name} <command>\` for builds, deploys, and the Tomcat lifecycle.
- Run integration tests with \`<gradlew> -I ${worktree_dir}/init-local.gradle testIntegration --tests <Class>\`.
EOF
}

_wt_report_drift() {
    # The seeded build output matches the template's HEAD; say whether this
    # checkout needs a full rebuild or only module deploys.
    local template="$1"
    local worktree_dir="$2"
    local env_name="$3"
    local template_head head
    template_head=$(git -C "$template" rev-parse HEAD)
    head=$(git -C "$worktree_dir" rev-parse HEAD)
    [[ "$template_head" == "$head" ]] && return 0

    local core
    core=$(git -C "$worktree_dir" diff --name-only "$template_head" "$head" -- \
        portal-kernel portal-impl portal-web util-bridges util-java util-slf4j util-taglib | head -n 1)
    echo
    if [[ -n "$core" ]]; then
        echo "Portal core differs from the template build: run 'lifcli -e ${env_name} rebuildFull' before starting."
    else
        echo "Only modules differ from the template build: 'lifcli -e ${env_name} deployChanged' deploys them."
    fi
}

_wt_new() {
    local name=""
    local dir_name=""
    local offset=""
    local base=""
    local family=""
    local mode="branch"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --base)
                base="$2"
                shift 2
                ;;
            --detach)
                mode="detach"
                shift
                ;;
            --dir-name)
                dir_name="$2"
                shift 2
                ;;
            --ee)
                family="ee"
                shift
                ;;
            --offset)
                offset="$2"
                shift 2
                ;;
            --reuse)
                mode="reuse"
                shift
                ;;
            -*)
                echo "Unknown flag: $1"
                return 1
                ;;
            *)
                [[ -z "$name" ]] && name="$1"
                shift
                ;;
        esac
    done

    if [[ -z "$name" ]]; then
        echo "Usage: wtcli new <NAME> [--ee] [--base REF] [--reuse | --detach] [--dir-name DIR] [--offset N]"
        return 1
    fi

    family=$(_wt_resolve_family "$family")
    local template
    template=$(_wt_template_dir "$family")
    if ! _wt_is_main_worktree "$template"; then
        echo "Template not found or not a main worktree: $template"
        return 1
    fi
    local default_base
    default_base=$(_wt_family_base "$family")
    [[ -z "$base" ]] && base="$default_base"
    [[ -z "$dir_name" ]] && dir_name="$(basename "$template")-${name}"
    local worktree_dir
    worktree_dir="$(dirname "$template")/${dir_name}"
    local env_name="${dir_name#liferay-}"

    # 1. Fetch and report alignment; warnings never block.
    _wt_check "$family"
    if [[ "$base" == "$default_base" ]]; then
        local upstream state
        upstream=$(_wt_family_upstream "$family")
        if [[ -n "$upstream" && "$base" != "$upstream" ]]; then
            state=$(_wt_compare "$template" "$base" "$upstream")
            if [[ "$state" == behind* || "$state" == diverged* ]]; then
                printf '\n*** WARNING: %s is %s relative to %s, so the new checkout starts from stale code. ***\n' "$base" "$state" "$upstream"
                printf '*** Align it first (wtcli sync, then push), or pass --base %s. ***\n' "$upstream"
            fi
        fi
    else
        _wt_fetch_refs "$template" "$base"
    fi
    echo

    # 2. Create the worktree.
    if [[ -d "$worktree_dir" ]]; then
        echo "Worktree directory already exists: $worktree_dir — skipping creation."
    else
        case "$mode" in
            detach)
                git -C "$template" worktree add --detach "$worktree_dir" "$base" || return 1
                ;;
            reuse)
                git -C "$template" worktree add "$worktree_dir" "$name" || return 1
                ;;
            branch)
                if ! git -C "$template" worktree add --no-track -b "$name" "$worktree_dir" "$base"; then
                    echo
                    echo "Branch creation failed (already exists?)."
                    echo "Retry with:  wtcli new $name --reuse"
                    return 1
                fi
                ;;
        esac
    fi

    # 3. Seed build output from the template.
    echo "Seeding build output from $template ..."
    _wt_seed_build_output "$template" "$worktree_dir" \
        || echo "Warning: seeding was incomplete; the first build may take longer."

    # 4. Copy the template bundle.
    local app_props="$worktree_dir/app.server.$(whoami).properties"
    if [[ ! -f "$app_props" ]]; then
        echo "app.server.parent.dir=${LIFERAY_BASE:-$(dirname "$template")}/bundles/${dir_name}-bundle" > "$app_props"
    fi
    local bundle_dir
    bundle_dir=$(_wt_resolve_bundle "$worktree_dir")
    if [[ -n "$(_wt_find_tomcat "$bundle_dir")" ]]; then
        echo "Existing bundle found at $bundle_dir — keeping it."
    else
        local template_bundle
        template_bundle=$(_wt_resolve_bundle "$template")
        if [[ -z "$(_wt_find_tomcat "$template_bundle")" ]]; then
            _wt_write_claude_local "$worktree_dir" "$env_name"
            echo "Template bundle $template_bundle has no Tomcat."
            echo "Build one with 'lifcli -e ${env_name} rebuildFull' (it configures the ports afterwards)."
            return 0
        fi
        echo "Copying bundle $template_bundle -> $bundle_dir ..."
        _wt_copy_bundle "$template_bundle" "$bundle_dir" "$template" "$worktree_dir" || return 1
    fi

    # 5. Claude instructions, ports, and database.
    _wt_write_claude_local "$worktree_dir" "$env_name"
    _wt_configure_ports "$worktree_dir" "$offset" || return 1
    _wt_report_drift "$template" "$worktree_dir" "$env_name"

    # 6. Next steps.
    echo
    echo "Worktree:    $worktree_dir"
    echo "Claude:      cd $worktree_dir && claude"
    echo "Start:       lifcli -e ${env_name} tomstart"
    echo "Clean up:    wtcli cleanup $worktree_dir"
}

# ==========================================
# Action: Status
# ==========================================
_wt_status() {
    local worktree_dir="${1:-$(git rev-parse --show-toplevel 2>/dev/null)}"
    if [[ -z "$worktree_dir" ]]; then
        echo "Not inside a Git repository and no worktree path provided."
        return 1
    fi
    local bundle_dir
    bundle_dir=$(_wt_resolve_bundle "$worktree_dir")
    local offset_file="$bundle_dir/.worktree-port-offset"
    if [[ ! -f "$offset_file" ]]; then
        echo "No .worktree-port-offset in $bundle_dir."
        return 1
    fi
    local offset
    offset=$(cat "$offset_file")
    local db_name
    db_name=$(_wt_db_name "$(basename "$worktree_dir")")
    _wt_print_summary "$worktree_dir" "$bundle_dir" "$offset" "$db_name"
}

# ==========================================
# Action: List
# ==========================================
_wt_list_row() {
    local worktree_path="$1"
    local running_bases="$2"
    local dir_name
    dir_name=$(basename "$worktree_path")
    local bundle_dir
    bundle_dir=$(_wt_resolve_bundle "$worktree_path")
    local tomcat_dir
    tomcat_dir=$(_wt_find_tomcat "$bundle_dir" "$worktree_path")

    local offset="(none)"
    local port="-"
    local db="-"
    local status="NO TOMCAT"

    if [[ -n "$tomcat_dir" ]]; then
        if [[ -f "$bundle_dir/.worktree-port-offset" ]]; then
            offset=$(cat "$bundle_dir/.worktree-port-offset")
            port=$((_WT_PORT_TOMCAT_HTTP + offset))
            db=$(_wt_db_name "$dir_name")
        else
            offset="?"
        fi
        if grep -qFx "$tomcat_dir" <<< "$running_bases"; then
            status="RUNNING"
        else
            status="STOPPED"
        fi
    fi
    printf '%-40s %-8s %-10s %-8s %s\n' "$dir_name" "$port" "$status" "$offset" "$db"
}

_wt_list() {
    local running_bases
    running_bases=$(_wt_running_tomcats)

    printf '%-40s %-8s %-10s %-8s %s\n' "Worktree" "Port" "Status" "Offset" "Database"
    printf '%-40s %-8s %-10s %-8s %s\n' "----------------------------------------" "--------" "----------" "--------" "------------------------"

    local family template current_path line
    for family in portal ee; do
        template=$(_wt_template_dir "$family")
        [[ -d "$template" ]] || continue
        current_path=""
        while IFS= read -r line; do
            if [[ "$line" == worktree\ * ]]; then
                current_path="${line#worktree }"
            elif [[ -z "$line" && -n "$current_path" ]]; then
                _wt_list_row "$current_path" "$running_bases"
                current_path=""
            fi
        done < <(git -C "$template" worktree list --porcelain 2>/dev/null; printf '\n')
    done
}

# ==========================================
# Action: Cleanup
# ==========================================
_wt_stop_tomcat() {
    # Stop the bundle's Tomcat and wait for it to exit; kill it after 60s.
    local bundle_dir="$1"
    local tomcat_dir="$2"
    pgrep -f "catalina.base=${bundle_dir}/" >/dev/null || return 0
    "$tomcat_dir/bin/catalina.sh" stop >/dev/null 2>&1
    local waited=0
    while pgrep -f "catalina.base=${bundle_dir}/" >/dev/null && (( waited < 60 )); do
        sleep 2
        waited=$((waited + 2))
    done
    pkill -KILL -f "catalina.base=${bundle_dir}/" >/dev/null 2>&1 || true
}

_wt_cleanup() {
    local worktree_dir=""
    local yes=0
    local delete_branch=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --delete-branch)
                delete_branch=1
                shift
                ;;
            --yes|-y)
                yes=1
                shift
                ;;
            -*)
                echo "Unknown flag: $1"
                return 1
                ;;
            *)
                [[ -z "$worktree_dir" ]] && worktree_dir="$1"
                shift
                ;;
        esac
    done

    [[ -z "$worktree_dir" ]] && worktree_dir=$(git rev-parse --show-toplevel 2>/dev/null)
    if [[ -z "$worktree_dir" ]]; then
        echo "Not inside a Git repository and no worktree path provided."
        return 1
    fi

    local abs_path
    abs_path=$(cd "$worktree_dir" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null)
    if [[ -z "$abs_path" ]]; then
        echo "Not a git worktree: $worktree_dir"
        return 1
    fi

    local dir_name
    dir_name=$(basename "$abs_path")
    if _wt_is_main_worktree "$abs_path"; then
        echo "Refusing to clean up the main '$dir_name' worktree."
        return 1
    fi

    local main_dir
    main_dir=$(_wt_main_worktree "$abs_path")
    local bundle_dir
    bundle_dir=$(_wt_resolve_bundle "$abs_path")
    local tomcat_dir
    tomcat_dir=$(_wt_find_tomcat "$bundle_dir" "$abs_path")
    local db_name
    db_name=$(_wt_db_name "$dir_name")
    local branch
    branch=$(_wt_worktree_branch "$abs_path")

    # Only a bundle wtcli created for this worktree is deleted.
    local owned_bundle="${LIFERAY_BASE:-$(dirname "$main_dir")}/bundles/${dir_name}-bundle"
    [[ "$bundle_dir" == "$owned_bundle" ]] || owned_bundle=""

    echo "About to clean up worktree:"
    echo "  Path:     $abs_path"
    echo "  Branch:   ${branch:-<detached>}$( (( delete_branch )) && echo ' (deleted)' || echo ' (kept)')"
    echo "  Database: $db_name"
    echo "  Tomcat:   ${tomcat_dir:-<none>}"
    echo "  Bundle:   ${owned_bundle:-<kept: not created by wtcli>}"
    if (( ! yes )); then
        read -r -p "Proceed? [y/N] " confirm
        if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
            echo "Aborted."
            return 0
        fi
    fi

    # 1. Stop tomcat
    [[ -n "$tomcat_dir" ]] && _wt_stop_tomcat "$bundle_dir" "$tomcat_dir"

    # 2. Remove worktree first: git refuses when it has uncommitted changes,
    #    and then nothing else is touched.
    if ! git -C "$main_dir" worktree remove "$abs_path"; then
        echo "git worktree remove failed; database and bundle left in place."
        return 1
    fi

    # 3. Drop database
    _wt_drop_database "$db_name"

    # 4. Delete bundle
    if [[ -n "$owned_bundle" && -d "$owned_bundle" ]]; then
        rm -rf "$owned_bundle"
        echo "Deleted $owned_bundle."
    fi

    # 5. Optionally delete branch
    if [[ -n "$branch" ]]; then
        if (( ! delete_branch && ! yes )); then
            read -r -p "Also delete local branch '$branch'? [y/N] " del
            [[ "$del" == "y" || "$del" == "Y" ]] && delete_branch=1
        fi
        if (( delete_branch )); then
            git -C "$main_dir" branch --delete --force "$branch"
        fi
    fi
}

# ==========================================
# Main CLI Entry Point
# ==========================================
wtcli() {
    local cmd="$1"
    if [[ -z "$cmd" || "$cmd" == "-h" || "$cmd" == "--help" ]]; then
        cat <<'EOF'
Usage: wtcli <command> [args...]

Templates: liferay-portal (offset 0) and liferay-ee (offset 1) stay built and
are never used for feature work. Commands pick the family from the cwd (any
worktree of that repository), else portal; --ee forces EE.

Commands:
  new <NAME> [--ee] [--base REF] [--reuse | --detach] [--dir-name DIR] [--offset N]
        Create liferay-<family>-<NAME> next to the template: reflink-copy the
        template's build output and bundle, then configure ports, database,
        and CLAUDE.local.md. Reports alignment first (never blocks).
        (default)         New branch NAME from REF (default: WTCLI_PORTAL_BASE
                          = origin/master, WTCLI_EE_BASE = liferay-ee/release-2026.q1).
        --base REF        Start from REF (e.g. a remote branch "remote/branch").
        --reuse           Check out the existing local branch NAME.
        --detach          No branch: detached checkout of REF, to just look.
        --dir-name DIR    Override the worktree directory name.
        --offset N        Force a port offset (auto-discovery starts at 2).

  check [--ee]
        Fetch, then compare the local base branch, the base (origin), and the
        upstream (what the local branch tracks; override WTCLI_PORTAL_UPSTREAM).

  sync [--ee]
        Fast-forward the local base branch when strictly behind the upstream.
        Never pushes: prints the push command for the base instead.

  configure [WORKTREE] [--offset N] [--no-db]
        Re-apply port configuration after a rebuild. Defaults to cwd's worktree.

  status [WORKTREE]
        Print the configured ports for one worktree.

  list
        Summary table of every worktree of both templates (port, status, offset, db).

  cleanup [WORKTREE] [--yes] [--delete-branch]
        Stop tomcat, remove the worktree (refused with uncommitted changes),
        drop the database, delete the wtcli-created bundle, and optionally the
        branch. Refuses the templates. --yes skips prompts and keeps the branch
        unless --delete-branch is given.
EOF
        return 0
    fi
    shift

    case "$cmd" in
        new)
            _wt_new "$@"
            ;;
        check|sync)
            local family=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --ee) family="ee"; shift ;;
                    *) echo "Unknown argument: $1"; return 1 ;;
                esac
            done
            family=$(_wt_resolve_family "$family")
            if [[ "$cmd" == "check" ]]; then
                _wt_check "$family"
            else
                _wt_sync "$family"
            fi
            ;;
        configure)
            local target="" off="" no_db=0
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --offset) off="$2"; shift 2 ;;
                    --no-db) no_db=1; shift ;;
                    -*) echo "Unknown flag: $1"; return 1 ;;
                    *) [[ -z "$target" ]] && target="$1"; shift ;;
                esac
            done
            [[ -z "$target" ]] && target=$(git rev-parse --show-toplevel 2>/dev/null)
            _wt_configure_ports "$target" "$off" "$no_db"
            ;;
        status)
            _wt_status "$@"
            ;;
        list)
            _wt_list "$@"
            ;;
        cleanup)
            _wt_cleanup "$@"
            ;;
        *)
            echo "Unknown command: $cmd"
            echo "Type 'wtcli --help' for usage."
            return 1
            ;;
    esac
}

# ==========================================
# Auto-Completion for wtcli
# ==========================================
_wtcli_completions() {
    local cur prev cmd
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    local commands="new check sync configure status list cleanup"

    if (( COMP_CWORD == 1 )); then
        COMPREPLY=( $(compgen -W "$commands -h --help" -- "$cur") )
        return 0
    fi

    cmd="${COMP_WORDS[1]}"
    case "$cmd" in
        new)
            if [[ "$prev" == "--dir-name" || "$prev" == "--offset" ]]; then
                COMPREPLY=()
            elif [[ "$prev" == "--base" ]]; then
                COMPREPLY=( $(compgen -W "$(git for-each-ref --format='%(refname:short)' refs/heads refs/remotes 2>/dev/null)" -- "$cur") )
            else
                COMPREPLY=( $(compgen -W "--ee --base --reuse --detach --dir-name --offset" -- "$cur") )
            fi
            ;;
        check|sync)
            COMPREPLY=( $(compgen -W "--ee" -- "$cur") )
            ;;
        configure)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=( $(compgen -W "--offset --no-db" -- "$cur") )
            else
                COMPREPLY=( $(compgen -d -- "$cur") )
            fi
            ;;
        cleanup)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=( $(compgen -W "--yes --delete-branch" -- "$cur") )
            else
                COMPREPLY=( $(compgen -d -- "$cur") )
            fi
            ;;
        status)
            COMPREPLY=( $(compgen -d -- "$cur") )
            ;;
        *)
            COMPREPLY=()
            ;;
    esac
}

complete -F _wtcli_completions wtcli
