#!/bin/bash

#
# 98-noint-liferay
#

# ==========================================
# Helpers
# ==========================================
_notify_task() {
    local title=$1
    local message=$2
    if command -v notify > /dev/null 2>&1; then
        notify "$title" "$message"
    else
        echo "$title" "-" "$message"
    fi
}

# ==========================================
# Private Command Functions
# ==========================================
_baseline() {
    blade gw baseline "$@"
    local build_exit_code=$?
    if [ $build_exit_code -ne 0 ]; then
        _notify_task "Baseline" "Failed."
    else
        _notify_task "Baseline" "Completed!"
    fi
    return $build_exit_code
}

_deploy() {
    blade gw deploy "$@"
    local build_exit_code=$?
    if [ $build_exit_code -ne 0 ]; then
        _notify_task "Deploy" "Failed."
    else
        _notify_task "Deploy" "Completed!"
    fi
    return $build_exit_code
}

_deploya() {
   _deploy -a -Pnodejs.node.env=development "$@"
}

_dropdb() {
    # Use $1 if provided, otherwise fallback to the current environment's DB name
    local db_name="${1:-$CURRENT_DB_NAME}"
    sudo -u postgres psql -c "drop database $db_name with (force);"
}

_recreatedb() {
    local db_name="${1:-$CURRENT_DB_NAME}"
    _dropdb "$db_name"
    sudo -u postgres psql -c "create database $db_name owner sa;"
}

_sf() {
    blade gw formatSource "$@"
    local build_exit_code=$?
    if [ $build_exit_code -ne 0 ]; then
        _notify_task "FormatSource" "Failed."
    else
        _notify_task "FormatSource" "Completed!"
    fi
    return $build_exit_code
}

_sfc() {
    if [[ -n "$CURRENT_LIFERAY_PRJ" ]]; then
        (
            cd "$CURRENT_LIFERAY_PRJ/portal-impl"
            ant format-source-current-branch
        )
        local ant_exit_code=$?
        if [ $ant_exit_code -ne 0 ]; then
            _notify_task "${PREFIX}Ant format-source-current-branch" "Build failed."
        else
            _notify_task "${PREFIX}Ant format-source-current-branch" "Build completed!"
        fi
        return $ant_exit_code
    else
        _notify_task "${PREFIX}Ant format-source-current-branch Failed" "You need to populate the LIFERAY_PRJ or LIFERAY_PRJ_EE env variable"
        return 1
    fi
}

_sfl() {
    if [[ -n "$CURRENT_LIFERAY_PRJ" ]]; then
