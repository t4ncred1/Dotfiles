_rebuild() {
    if [[ -n "$CURRENT_LIFERAY_PRJ" ]]; then
        (
            cd "$CURRENT_LIFERAY_PRJ"
            ant setup-sdk && ant setup-profile-dxp && ij && ant all && ij
        )
        local ant_exit_code=$?
        if [ $ant_exit_code -ne 0 ]; then
            _notify_task "${PREFIX}Ant all" "Build failed."
        else
            _notify_task "${PREFIX}Ant all" "Build completed!"
        fi
        return $ant_exit_code
    else
        _notify_task "${PREFIX}Ant all Failed" "You need to populate the LIFERAY_PRJ or LIFERAY_PRJ_EE env variable"
        return 1
    fi
}

_rebuildFull() {
    if [[ -n "$CURRENT_LIFERAY_PRJ" ]]; then
        (
            cd "$CURRENT_LIFERAY_PRJ" &&
            git clean -dfx -e ".claude/" -e "build.$(whoami).properties" -e "app.server.$(whoami).properties" -e "test.$(whoami).properties" &&
            ant setup-sdk && ant setup-profile-dxp && ij && ant all && ij
        )
        local ant_exit_code=$?
        if [ $ant_exit_code -ne 0 ]; then
            _notify_task "${PREFIX}Ant all" "Build failed."
        else
            _notify_task "${PREFIX}Ant all" "Build completed!"
        fi
        return $ant_exit_code
    else
        _notify_task "${PREFIX}Ant all Failed" "You need to populate the LIFERAY_PRJ or LIFERAY_PRJ_EE env variable"
        return 1
    fi
}

_gw() {
    blade gw "$@"
}

_gwtest() {
    blade gw test "$@"
}

_testIntegration() {
   blade gw testIntegration "$@"
}

_tomclear() {
    if [[ -z "$CURRENT_LIFERAY_HOME" ]]; then
        _notify_task "${PREFIX}Clear tomcat failed" "You need to populate the LIFERAY_HOME or LIFERAY_HOME_EE env variable"
        return 1
    fi

    local folders_to_empty=(
        "osgi/state"
        "tomcat/work"
        "tomcat/temp"
    )

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dir)
                if [[ -n "$2" && "$2" != --* ]]; then
                    folders_to_empty+=("$2")
                    shift 2
                else
                    echo "Error: --dir requires a value."
                    return 1
                fi
                ;;
            *)
                echo "Unknown parameter: $1"
                shift
                ;;
        esac
    done

    for folder in "${folders_to_empty[@]}"; do
        local full_path="${CURRENT_LIFERAY_HOME}/${folder}"

        if [ -d "$full_path" ]; then
            if [ "$(ls -A "$full_path" 2>/dev/null)" ]; then
                echo "Emptying directory $full_path."
                rm -rf "$full_path"/*
            else
                echo "Directory $full_path is empty already."
            fi
        else
            echo "Directory $full_path does not exist. Skipping."
        fi
    done
}

_tomclearfull() {
    _tomclear --dir "data"
}

_tominit() {
    _tomstop
    _tomclearfull && _recreatedb "$@" && _tomstart
}

_tomlog() {
    if [[ -z "$CURRENT_LIFERAY_HOME" ]]; then
        echo "Error: You need to populate the LIFERAY_HOME or LIFERAY_HOME_EE env variable."
        return 1
    fi
    if [[ -z "$PAGER" ]]; then
        echo "Error: you need to define a pager in your PAGER env variable."
        return 1
    fi

    local tomcat_log="$CURRENT_LIFERAY_HOME/tomcat/logs/catalina.out"
    $PAGER "$tomcat_log"
}

_tomrestart() {
    _tomstop
    _tomclear && _tomstart
}

_tomstart() {
    if [[ -n "$CURRENT_LIFERAY_HOME" ]]; then
        local tomcat_log="$CURRENT_LIFERAY_HOME/tomcat/logs/catalina.out"
        rm -rf "$tomcat_log" &&
        "$CURRENT_LIFERAY_HOME/tomcat/bin/catalina.sh" glowroot jpda start &&
        if [[ -n "$PAGER" ]]; then
            $PAGER "$tomcat_log"
        fi
    else
        _notify_task "${PREFIX}Start failed" "You need to populate the LIFERAY_HOME or LIFERAY_HOME_EE env variable"
        return 1
    fi
}

_tomstop() {
    if [[ -n "$CURRENT_LIFERAY_HOME" ]]; then
        "$CURRENT_LIFERAY_HOME/tomcat/bin/catalina.sh" stop
    else
        _notify_task "${PREFIX}Stop failed" "You need to populate the LIFERAY_HOME or LIFERAY_HOME_EE env variable"
        return 1
    fi
}

# ==========================================
# Main CLI Entry Point
# ==========================================
lifcli() {
    # Default variables (Standard)
    local CURRENT_LIFERAY_PRJ="$LIFERAY_PRJ"
    local CURRENT_LIFERAY_HOME="$LIFERAY_HOME"
    local CURRENT_DB_NAME="lportal"
    local PREFIX=""

    # 1. Parse global flags
    while [[ $# -gt 0 && "$1" == -* ]]; do
        case "$1" in
            -e|--env)
                if [[ -z "$2" || "$2" == -* ]]; then
                    echo "Error: $1 requires a name argument"
                    return 1
                fi
                if [[ -z "$LIFERAY_BASE" ]]; then
                    echo "Error: LIFERAY_BASE env variable must be set to use $1"
                    return 1
                fi
                CURRENT_LIFERAY_PRJ="$LIFERAY_BASE/liferay-$2"
                CURRENT_LIFERAY_HOME="$LIFERAY_BASE/bundles/liferay-$2-bundle"
                CURRENT_DB_NAME="lportal$2"
                PREFIX="${2^^} - "
                shift 2
                ;;
            --ee)
                CURRENT_LIFERAY_PRJ="$LIFERAY_PRJ_EE"
                CURRENT_LIFERAY_HOME="$LIFERAY_HOME_EE"
                CURRENT_DB_NAME="lportalee"
                PREFIX="EE - "
                shift
                ;;
            -h|--help)
                echo "Usage: lifcli [--ee | -e <name> | --env <name>] <command> [args...]"
                echo "  -e <name> | --env <name>  Resolves against \$LIFERAY_BASE to:"
                echo "                              source: \$LIFERAY_BASE/liferay-<name>"
                echo "                              bundle: \$LIFERAY_BASE/liferay-<name>-bundle"
                echo "                              db:     lportal<name>"
                echo "Commands: baseline, deploy, deploya, dropdb, recreatedb, sf, sfc, sfl, buildPortalService, buildRest, buildService, buildLanguage, lifIj, rebuild, rebuildFull, testIntegration, tomclear, tomclearfull, tominit, tomlog, tomrestart, tomstart, tomstop"
                return 0
                ;;
            *)
                echo "Error: Unknown global option '$1'"
                return 1
                ;;
        esac
    done

    # 2. Extract the command
    local cmd="$1"

    if [[ -z "$cmd" ]]; then
        echo "Error: No command provided."
        echo "Usage: lifcli [-e|--ee] <command> [args...]"
        return 1
    fi

    # Shift past the command name so "$@" only contains command-specific arguments
    shift

    echo -e "Command:\t$cmd"
    echo -e "Liferay source:\t$CURRENT_LIFERAY_PRJ"
    echo -e "Liferay home:\t$CURRENT_LIFERAY_HOME"
    echo -e "Liferay db:\t$CURRENT_DB_NAME"

    # 3. Explicit command routing
    case "$cmd" in
        baseline)           _baseline "$@" ;;
        deploy)             _deploy "$@" ;;
        deploya)            _deploya "$@" ;;
        dropdb)             _dropdb "$@" ;;
        gw)                 _gw "$@" ;;
        gwtest)             _gwtest "$@" ;;
        recreatedb)         _recreatedb "$@" ;;
        sf)                 _sf "$@" ;;
        sfc)                _sfc "$@" ;;
        sfl)                _sfl "$@" ;;
        buildPortalService) _buildPortalService "$@" ;;
        buildRest)          _buildRest "$@" ;;
        buildService)       _buildService "$@" ;;
        buildLanguage)      _buildLanguage "$@" ;;
        ij)                 _ij "$@" ;;
        rebuild)            _rebuild "$@" ;;
        rebuildFull)        _rebuildFull "$@" ;;
        testIntegration)    _testIntegration "$@" ;;
        tomclear)           _tomclear "$@" ;;
        tomclearfull)       _tomclearfull "$@" ;;
        tominit)            _tominit "$@" ;;
        tomlog)             _tomlog "$@" ;;
        tomrestart)         _tomrestart "$@" ;;
        tomstart)           _tomstart "$@" ;;
        tomstop)            _tomstop "$@" ;;
        *)
            echo "Error: Unknown command '$cmd'"
            echo "Type 'lifcli --help' for a list of valid commands."
            return 1
            ;;
    esac
}

# ==========================================
# Auto-Completion for lifcli
# ==========================================
_lifcli_completions() {
    local cur prev cmd i

    # Current word being typed
    cur="${COMP_WORDS[COMP_CWORD]}"
    # Previous word typed
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    # Define our lists of valid inputs
    local commands="baseline deploy deploya dropdb recreatedb sf sfc sfl buildPortalService buildRest buildService buildLanguage lifIj rebuild rebuildFull gwtest testIntegration tomclear tomclearfull tominit tomlog tomrestart tomstart tomstop"
    local global_flags="-e --env --ee -h --help"

    # 1. Figure out if the user has already typed a subcommand
    cmd=""
    for (( i=1; i < COMP_CWORD; i++ )); do
        local word="${COMP_WORDS[i]}"
        # If a word matches one of our commands, save it and stop looking
        if [[ " $commands " == *" $word "* ]]; then
            cmd="$word"
            break
        fi
    done

    # 2. If no subcommand is found yet, suggest commands or global flags
    if [[ -z "$cmd" ]]; then
        # If completing the value after -e/--env, suggest worktree names from $LIFERAY_BASE
        if [[ "$prev" == "-e" || "$prev" == "--env" ]]; then
            if [[ -n "$LIFERAY_BASE" && -d "$LIFERAY_BASE" ]]; then
                local names=()
                local dir base
                for dir in "$LIFERAY_BASE"/liferay-*; do
                    [[ -d "$dir" ]] || continue
                    base="${dir##*/}"
                    [[ "$base" == *-bundle ]] && continue
                    names+=( "${base#liferay-}" )
                done
                COMPREPLY=( $(compgen -W "${names[*]}" -- "$cur") )
            fi
            return 0
        fi
        if [[ "$cur" == -* ]]; then
            # If typing a flag, only suggest global flags
            COMPREPLY=( $(compgen -W "$global_flags" -- "$cur") )
        else
            # Otherwise suggest both flags and commands
            COMPREPLY=( $(compgen -W "$commands $global_flags" -- "$cur") )
        fi
        return 0
    fi

    # 3. Subcommand-specific completions
    case "$cmd" in
        tomclear)
            # tomclear accepts a --dir flag
            if [[ "$cur" == -* ]]; then
                COMPREPLY=( $(compgen -W "--dir" -- "$cur") )
            elif [[ "$prev" == "--dir" ]]; then
                # If they typed --dir, autocomplete local directories
                COMPREPLY=( $(compgen -d -- "$cur") )
            fi
            ;;
        *)
            # No specific flags for other commands yet
            COMPREPLY=()
            ;;
    esac
}

# Bind the completion function to 'lifcli'
complete -F _lifcli_completions lifcli
