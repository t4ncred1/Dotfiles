# ==========================================
# Helpers
# ==========================================
_notify_task() {
    local title=$1
    local message=$2
    if command -v notify > /dev/null 2>&1; then
        notify "$title" "$message"
    else
        echo "$title" "-" "$message"
    fi
}

_gradle_init_args() {
    # Echoes `-I <abs-path>` when init-local.gradle exists at the project root,
    # so wtcli-configured port overrides (testIntegrationTomcat.portNumber,
    # liferay.arquillian.port) are applied to every gradle command.
    if [[ -n "$CURRENT_LIFERAY_PRJ" && -f "$CURRENT_LIFERAY_PRJ/init-local.gradle" ]]; then
        echo "-I $CURRENT_LIFERAY_PRJ/init-local.gradle"
    fi
}

# ==========================================
# Private Command Functions
# ==========================================
_baseline() {
    blade gw $(_gradle_init_args) baseline "$@"
    local build_exit_code=$?
    if [ $build_exit_code -ne 0 ]; then
        _notify_task "Baseline" "Failed."
    else
        _notify_task "Baseline" "Completed!"
    fi
    return $build_exit_code
}

_deploy() {
    blade gw $(_gradle_init_args) deploy "$@"
    local build_exit_code=$?
    if [ $build_exit_code -ne 0 ]; then
        _notify_task "Deploy" "Failed."
    else
        _notify_task "Deploy" "Completed!"
    fi
    return $build_exit_code
}

_deploya() {
   _deploy -a -Pnodejs.node.env=development "$@"
}

_deployChanged() {
    # Deploy the modules changed since the template build (committed,
    # uncommitted, and untracked). Portal core changes need rebuildFull.
    local since="$1"
    if [[ -z "$since" ]]; then
        local family
        if ! family=$(_wt_family_of "$CURRENT_LIFERAY_PRJ"); then
            echo "Not a worktree of a template; pass the base commit: lifcli ... deployChanged <ref>"
            return 1
        fi
        since=$(git -C "$(_wt_template_dir "$family")" rev-parse HEAD)
    fi

    local files
    files=$( {
        git -C "$CURRENT_LIFERAY_PRJ" diff --name-only "$since"
        git -C "$CURRENT_LIFERAY_PRJ" ls-files --others --exclude-standard
    } | sort -u)

    local core
    core=$(grep -E '^(portal-kernel|portal-impl|portal-web|util-[a-z0-9]+)/' <<< "$files")
    if [[ -n "$core" ]]; then
        echo "Portal core changed since ${since:0:12}; run 'lifcli ... rebuildFull' instead:"
        printf '  %s\n' $(cut -d/ -f1 <<< "$core" | sort -u)
        return 1
    fi

    # Map each changed file to its module (the nearest dir with a bnd.bnd);
    # *-test modules are wired in by testIntegration and never deployed.
    local modules=() file dir
    while IFS= read -r file; do
        [[ "$file" == modules/* ]] || continue
        dir=$(dirname "$file")
        while [[ "$dir" == modules/* && ! -f "$CURRENT_LIFERAY_PRJ/$dir/bnd.bnd" ]]; do
            dir=$(dirname "$dir")
        done
        [[ -f "$CURRENT_LIFERAY_PRJ/$dir/bnd.bnd" && "$dir" != *-test ]] && modules+=("$dir")
    done <<< "$files"
    if (( ${#modules[@]} == 0 )); then
        echo "No changed modules to deploy since ${since:0:12}."
        return 0
    fi
    mapfile -t modules < <(printf '%s\n' "${modules[@]}" | sort -u)

    printf 'Deploying %d module(s) changed since %s:\n' "${#modules[@]}" "${since:0:12}"
    printf '  %s\n' "${modules[@]}"
    local module failed=()
    for module in "${modules[@]}"; do
        (cd "$CURRENT_LIFERAY_PRJ/$module" && blade gw $(_gradle_init_args) deploy) || failed+=("$module")
    done
    if (( ${#failed[@]} )); then
        _notify_task "${PREFIX}Deploy changed" "Failed: ${failed[*]}"
        return 1
    fi
    _notify_task "${PREFIX}Deploy changed" "Completed!"
}

_dropdb() {
    # Use $1 if provided, otherwise fallback to the current environment's DB name
    local db_name="${1:-$CURRENT_DB_NAME}"
    _wt_psql -c "drop database if exists $db_name with (force);"
}

_recreatedb() {
    local db_name="${1:-$CURRENT_DB_NAME}"
    _dropdb "$db_name"
    _wt_psql -c "create database $db_name owner sa;"
}

_reapply_worktree_ports() {
    # ant all can unpack a fresh tomcat-* with default ports; re-apply the
    # bundle's wtcli offset (kept in .worktree-port-offset), leaving the DB alone.
    # A feature worktree built from scratch has no offset yet: allocate one
    # and create its database.
    if [[ -f "$CURRENT_LIFERAY_HOME/.worktree-port-offset" ]]; then
        _wt_configure_ports "$CURRENT_LIFERAY_PRJ" "" 1
    elif _wt_family_of "$CURRENT_LIFERAY_PRJ" >/dev/null && ! _wt_is_main_worktree "$CURRENT_LIFERAY_PRJ"; then
        _wt_configure_ports "$CURRENT_LIFERAY_PRJ" ""
    fi
}

